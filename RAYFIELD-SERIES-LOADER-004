local function tracedPCall(fn, ...)
	local args = table.pack(...)
	return xpcall(function()
		return fn(table.unpack(args, 1, args.n))
	end, function(err)
		return tostring(err) .. "\n" .. debug.traceback("", 2)
	end)
end

